    <string name="privacy_phone_body">Notes, drawings, images, and projects live in a local database. You can write with no account.</string>
    <string name="privacy_in">If you sign in</string>
    <string name="privacy_in_body">We send your email (and Google account, if you use it) to Clerk, our sign-in provider. Notes you choose to sync go to Convex, our sync provider. Locked notes upload only as ciphertext. Search text of locked notes is not stored.</string>
    <string name="privacy_out">If you don’t sign in</string>
    <string name="privacy_out_body">Nothing leaves this phone. There is no cloud copy.</string>
    <string name="privacy_backup">Backups</string>
    <string name="privacy_backup_body">Android cloud backup does not include your notes database in v1. A new phone will not restore locked notes. Sign in and Sync if you want a copy.</string>
    <string name="privacy_delete">Delete</string>
    <string name="privacy_delete_body">Sign out keeps local notes. Delete account removes the Clerk user and the cloud copy. Local notes stay until you delete them here.</string>
